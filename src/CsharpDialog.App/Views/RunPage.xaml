<Page
    x:Class="csharpDialog.App.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Run Control Bar ═══ -->
        <Grid Grid.Row="0" Padding="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Run / Stop Button -->
            <Button x:Name="RunButton" Grid.Column="0" Click="RunButton_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="RunIcon" Glyph="&#xE768;" FontSize="16" />
                    <TextBlock x:Name="RunText" Text="Show Test Dialog" />
                </StackPanel>
            </Button>

            <!-- Preset picker -->
            <ComboBox x:Name="PresetPicker" Grid.Column="1" Margin="12,0,0,0" MinWidth="160"
                      VerticalAlignment="Center" DisplayMemberPath="Name"
                      SelectionChanged="PresetPicker_SelectionChanged" />

            <!-- Debug + Clear -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                <CheckBox x:Name="DebugToggle" Content="Debug" Checked="DebugToggle_Changed"
                          Unchecked="DebugToggle_Changed" />
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>

            <!-- Right-aligned status -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Running indicator -->
                <ProgressRing x:Name="RunningProgress" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="RunningLabel" Text="Dialog open..."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Visibility="Collapsed" />

                <!-- Status indicator -->
                <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon x:Name="StatusIcon" FontSize="16" />
                    <TextBlock x:Name="StatusText" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ Preset description + command line ═══ -->
        <StackPanel Grid.Row="1" Spacing="4" Padding="24,0,24,12">
            <TextBlock x:Name="PresetDescription"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PresetCommand"
                       FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>

        <!-- ═══ Error / Success Banner ═══ -->
        <InfoBar x:Name="ResultBanner" Grid.Row="2"
                 IsOpen="False" IsClosable="True" Margin="24,0,24,8" />

        <!-- ═══ Divider ═══ -->
        <MenuFlyoutSeparator Grid.Row="3" />

        <!-- ═══ Console Output ═══ -->
        <ScrollViewer x:Name="ConsoleScroller" Grid.Row="4" Padding="12"
                      Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <RichTextBlock x:Name="ConsoleOutput" IsTextSelectionEnabled="True"
                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                           TextWrapping="Wrap" Padding="4,0" />
        </ScrollViewer>
    </Grid>
</Page>
