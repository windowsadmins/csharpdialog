<Page
    x:Class="csharpDialog.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:csharpDialog.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,24,28,24">
            <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Center">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed Notifications Dialog"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="User dialogs and notifications for managed Windows devices, driven by csharpDialog."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/windowsadmins/csharpdialog#readme" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/windowsadmins/csharpdialog/issues" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Read-only banner: csharpDialog has no machine settings to edit ═══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                               Text="Every dialog option is a command-line flag on dialog.exe. The one setting, the authorisation key, comes only from policy, so this tab is read-only." />
                </Grid>
            </Border>

            <!-- ═══ Authorisation key: policy only ═══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE72E;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Authorisation key" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border x:Name="ManagedBadge" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="Managed" FontSize="11"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.AuthorisationKeyStatus}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <!-- ═══ Info Grid: 2-column card layout ═══ -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ── Version Card ── -->
                <Border Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE7EF;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Version" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Managed Notifications Dialog" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" IsReadOnly="True" />

                    <TextBlock Text="csharpDialog CLI (dialog.exe)" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.CliVersion, Mode=OneWay}" IsReadOnly="True" />
                </StackPanel>
                </Border>

                <!-- ── Paths Card ── -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Paths" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Install folder" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.InstallDirectory}" IsReadOnly="True" />
                        <Button Grid.Column="1" Click="OpenInstallFolder_Click" Width="36" Padding="6"
                                ToolTipService.ToolTip="Open install folder">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                        </Button>
                    </Grid>

                    <TextBlock Text="CLI" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.CliPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />

                    <TextBlock Text="This app" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.GuiPath}" IsReadOnly="True" TextWrapping="Wrap" />

                    <TextBlock Text="Log folder" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.LogDirectory}" IsReadOnly="True" />
                        <Button Grid.Column="1" Click="OpenLogFolder_Click" Width="36" Padding="6"
                                ToolTipService.ToolTip="Open log folder">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
